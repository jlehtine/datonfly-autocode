{
    "name": "@datonfly-autocode/control-plane",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/main.js",
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc --project tsconfig.build.json",
        "start": "node dist/main.js",
        "dev": "tsc-watch --project tsconfig.build.json --onSuccess \"node dist/main.js\"",
        "test": "vitest run",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix"
    },
    "dependencies": {
        "@datonfly-autocode/build-deploy": "workspace:*",
        "@datonfly-autocode/core": "workspace:*",
        "@datonfly-autocode/orchestrator": "workspace:*",
        "@datonfly-autocode/repo-git": "workspace:*",
        "@datonfly-autocode/sandbox-docker": "workspace:*",
        "@nestjs/common": "^11.1.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.1.0",
        "@nestjs/platform-express": "^11.1.0",
        "@nestjs/platform-socket.io": "^11.1.0",
        "@nestjs/websockets": "^11.1.0",
        "nestjs-pino": "^4.6.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.0",
        "socket.io": "^4.8.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^25.5.2",
        "tsc-watch": "^7.2.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
